# Gmail SMTP credentials for deal notification emails.
#
# Copy this file to ".env" and fill in your values:
#   cp .env.example .env        (Git Bash / macOS / Linux)
#   copy .env.example .env      (Windows CMD)
#
# SETUP:
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification"
# 3. Search for "App passwords" in Google Account settings
# 4. Create a new App Password (Mail + your device)
# 5. Paste the 16-character password below (no spaces)
#
# Email notifications are optional — the API runs without these,
# but price alerts will not be sent until both values are set.

GMAIL_SENDER=your.email@gmail.com
GMAIL_APP_PASS=your_16_char_app_password
